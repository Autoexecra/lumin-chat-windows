<Window x:Class="LuminChatWin.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="综合设置"
    Icon="Assets/Lumin-Chat图标.png"
        Width="1240"
        Height="860"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="24" Padding="20">
            <TabControl TabStripPlacement="Left">
                <TabItem Header="一般">
                    <ScrollViewer><StackPanel x:Name="GeneralPanel" Margin="20,0,0,0"/></ScrollViewer>
                </TabItem>
                <TabItem Header="提示词">
                    <ScrollViewer><StackPanel x:Name="PromptPanel" Margin="20,0,0,0"/></ScrollViewer>
                </TabItem>
                <TabItem Header="命令策略">
                    <ScrollViewer><StackPanel x:Name="PolicyPanel" Margin="20,0,0,0"/></ScrollViewer>
                </TabItem>
                <TabItem Header="终端">
                    <ScrollViewer><StackPanel x:Name="TerminalPanel" Margin="20,0,0,0"/></ScrollViewer>
                </TabItem>
                <TabItem Header="登录与探测">
                    <ScrollViewer><StackPanel x:Name="CommandExecutionPanel" Margin="20,0,0,0"/></ScrollViewer>
                </TabItem>
                <TabItem Header="辅助服务器">
                    <ScrollViewer><StackPanel x:Name="SecondaryPanel" Margin="20,0,0,0"/></ScrollViewer>
                </TabItem>
                <TabItem Header="资料库">
                    <ScrollViewer><StackPanel x:Name="KnowledgePanel" Margin="20,0,0,0"/></ScrollViewer>
                </TabItem>
                <TabItem Header="许可证与调试">
                    <ScrollViewer><StackPanel x:Name="LicensePanel" Margin="20,0,0,0"/></ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" Click="Save_Click"/>
            <Button Content="关闭" Style="{StaticResource SubtleButtonStyle}" Click="Close_Click" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>