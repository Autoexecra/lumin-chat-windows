<Window x:Class="LuminChatWin.App.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Session"
    Icon="Assets/Lumin-Chat图标.png"
        Width="1480"
        Height="980"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="22" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="会话窗口" FontSize="22" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <ComboBox x:Name="ModelLevelComboBox" Width="120" SelectionChanged="ModelLevelComboBox_SelectionChanged"/>
                    <ComboBox x:Name="ApprovalPolicyComboBox" Width="140" SelectionChanged="ApprovalPolicyComboBox_SelectionChanged" Margin="0,0,8,0"/>
                    <Button Content="新建会话" Click="NewSession_Click"/>
                    <Button Content="刷新会话列表" Style="{StaticResource SubtleButtonStyle}" Click="RefreshSessions_Click"/>
                    <Button Content="批任务运行" Style="{StaticResource SubtleButtonStyle}" Click="RunBatch_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="LLM 配置" Style="{StaticResource SubtleButtonStyle}" Click="OpenLlmConfig_Click"/>
                    <Button Content="综合设置" Style="{StaticResource SubtleButtonStyle}" Click="OpenSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.42*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="0.58*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="历史会话" FontSize="18" FontWeight="SemiBold"/>
                        <ListBox Grid.Row="1" x:Name="SessionListBox" ItemsSource="{Binding Sessions}" MouseDoubleClick="SessionListBox_MouseDoubleClick" Margin="0,14,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SessionId}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Cwd}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource BorderBrush}" ShowsPreview="True" ResizeDirection="Rows"/>

                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="工具轨迹" FontSize="18" FontWeight="SemiBold"/>
                        <ListBox Grid.Row="1" x:Name="ToolLogListBox" ItemsSource="{Binding ToolLogs}" Margin="0,14,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2" Text="模型思考" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8"/>
                        <TextBox Grid.Row="3" Text="{Binding ThinkingText}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" ShowsPreview="True" ResizeDirection="Columns"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="280"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="190" MinHeight="120"/>
                </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="24" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SessionHeaderTextBlock" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusTextBlock" Margin="18,2,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" x:Name="ConversationScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                        <ItemsControl ItemsSource="{Binding Conversation}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Background}" CornerRadius="18" Padding="16" Margin="0,0,0,14" HorizontalAlignment="{Binding Alignment}" MaxWidth="980">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                                <TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{StaticResource BorderBrush}" ShowsPreview="True" ResizeDirection="Rows"/>
                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="18" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PromptTextBox" Grid.Column="0" MinHeight="120" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" KeyDown="PromptTextBox_KeyDown"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Bottom">
                            <Button x:Name="SendButton" Content="发送" Click="SendButton_Click" Margin="0,0,0,8"/>
                            <Button Content="清空输入" Style="{StaticResource SubtleButtonStyle}" Click="ClearInput_Click" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>