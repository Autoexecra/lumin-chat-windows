<Window x:Class="LuminChatWin.App.TerminalControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LuminChatWin.Core.Models;assembly=LuminChatWin.Core"
        Title="Lumin Chat Terminal"
        Icon="Assets/Lumin-Chat图标.png"
        Width="1540"
        Height="920"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="24" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="串口控制与终端编排" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="统一管理 PowerShell、SSH、Telnet、串口会话，并提供 Agent 规划、外部 API 和串口桥接入口。" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource AccentBrush}" CornerRadius="18" Padding="18">
                    <StackPanel>
                        <TextBlock Text="本地 API" Foreground="White" FontSize="14"/>
                        <TextBlock x:Name="ApiSummaryTextBlock" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,12" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="切换 API" Click="ToggleApi_Click"/>
                            <Button Content="刷新会话" Style="{StaticResource SubtleButtonStyle}" Click="RefreshSessions_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="22" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="会话列表" FontSize="20" FontWeight="SemiBold"/>
                    <ListBox x:Name="SessionsListBox" Grid.Row="1" Margin="0,14,0,14" SelectionChanged="SessionsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TerminalSessionInfo}">
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock Text="{Binding Kind}" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{Binding Descriptor}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="刷新串口" Click="RefreshSerialPorts_Click"/>
                        <Button Content="关闭会话" Style="{StaticResource SubtleButtonStyle}" Click="CloseSession_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" Width="10" Background="Transparent"/>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="22" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="190"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="SessionTitleTextBlock" Text="未选择会话" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SessionMetaTextBlock" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CurrentCommandTextBlock" Margin="0,10,0,0" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBox x:Name="OutputTextBox"
                             Grid.Row="1"
                             Margin="0,16,0,0"
                             FontFamily="Consolas"
                             FontSize="13"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             TextWrapping="Wrap"/>

                    <GridSplitter Grid.Row="2" Height="10" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="历史轨迹" FontSize="16" FontWeight="SemiBold"/>
                            <ListBox x:Name="HistoryListBox" Grid.Row="1" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="12" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CommandTextBox" Margin="0"/>
                            <Button Grid.Column="1" Content="执行命令" Margin="10,0,8,0" Click="ExecuteCommand_Click"/>
                            <Button Grid.Column="2" Content="发送原始" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0" Click="SendRawInput_Click"/>
                            <Button Grid.Column="3" Content="Ctrl+C" Style="{StaticResource SubtleButtonStyle}" Click="InterruptCommand_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Center" Width="10" Background="Transparent"/>

            <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" CornerRadius="22" Padding="16">
                <TabControl TabStripPlacement="Left">
                    <TabItem Header="连接">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,0,0,0">
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="PowerShell" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBox x:Name="PowerShellTitleTextBox" Text="本地 PowerShell"/>
                                        <TextBox x:Name="PowerShellProgramTextBox"/>
                                        <TextBox x:Name="PowerShellArgsTextBox"/>
                                        <TextBox x:Name="PowerShellWorkdirTextBox"/>
                                        <Button Content="连接 PowerShell" Click="ConnectPowerShell_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="SSH" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBox x:Name="SshTitleTextBox" Text="SSH 会话"/>
                                        <TextBox x:Name="SshHostTextBox" Text="127.0.0.1"/>
                                        <TextBox x:Name="SshPortTextBox" Text="22"/>
                                        <TextBox x:Name="SshUsernameTextBox" Text="root"/>
                                        <PasswordBox x:Name="SshPasswordBox" Margin="0,0,0,8" Padding="10,8"/>
                                        <Button Content="连接 SSH" Click="ConnectSsh_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Telnet" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TelnetTitleTextBox" Text="Telnet 会话"/>
                                        <TextBox x:Name="TelnetHostTextBox" Text="127.0.0.1"/>
                                        <TextBox x:Name="TelnetPortTextBox" Text="23"/>
                                        <Button Content="连接 Telnet" Click="ConnectTelnet_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="串口" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBox x:Name="SerialTitleTextBox" Text="串口会话"/>
                                        <ComboBox x:Name="SerialPortComboBox" IsEditable="True"/>
                                        <TextBox x:Name="SerialBaudRateTextBox" Text="115200"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="SerialParityTextBox" Text="None" Width="110" Margin="0,0,8,8"/>
                                            <TextBox x:Name="SerialDataBitsTextBox" Text="8" Width="90" Margin="0,0,8,8"/>
                                            <TextBox x:Name="SerialStopBitsTextBox" Text="One" Width="90" Margin="0,0,0,8"/>
                                        </StackPanel>
                                        <Button Content="连接串口" Click="ConnectSerial_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Agent">
                        <Grid Margin="10,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="让 Agent 规划下一条命令；可自动执行，也可只给建议。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="AgentObjectiveTextBox" Grid.Row="1" AcceptsReturn="True" Height="90" TextWrapping="Wrap" Text="描述你希望终端完成的目标，例如：登录设备后检查版本并导出关键日志。"/>
                            <ListBox x:Name="AgentDialogueListBox" Grid.Row="2" Margin="0,8,0,8"/>
                            <TextBox x:Name="AgentUserInputTextBox" Grid.Row="3" AcceptsReturn="True" Height="74" TextWrapping="Wrap"/>
                            <StackPanel Grid.Row="4">
                                <CheckBox x:Name="AgentAutoExecuteCheckBox" Content="Agent 直接执行建议命令" Margin="0,0,0,10"/>
                                <TextBlock Text="建议命令" FontWeight="SemiBold"/>
                                <TextBox x:Name="SuggestedCommandTextBox" AcceptsReturn="True" Height="74" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="发送给 Agent" Click="SendAgentMessage_Click"/>
                                    <Button Content="Agent 下一步" Click="RunAgentStep_Click"/>
                                    <Button Content="执行建议" Style="{StaticResource SubtleButtonStyle}" Click="ExecuteSuggested_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="API / Bridge">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,0,0,0">
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="执行 API" FontSize="18" FontWeight="SemiBold"/>
                                        <CheckBox x:Name="ApiEnabledCheckBox" Content="启用本地 HTTP API" Margin="0,10,0,8"/>
                                        <TextBox x:Name="ApiHostTextBox"/>
                                        <TextBox x:Name="ApiPortTextBox"/>
                                        <TextBox x:Name="ApiTimeoutTextBox"/>
                                        <TextBlock x:Name="ApiEndpointsTextBlock" Margin="0,8,0,10" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                        <Button Content="保存并切换 API" Click="ToggleApi_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="串口 SSH Bridge" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="当前实现先提供本地 TCP 中继预览，便于外部工具和自动化脚本接入串口会话。" Margin="0,8,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                        <TextBox x:Name="BridgePortTextBox" Text=""/>
                                        <Button Content="为当前串口会话打开 Bridge" Click="OpenBridge_Click"/>
                                        <TextBlock x:Name="BridgeStatusTextBlock" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>